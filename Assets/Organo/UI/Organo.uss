/* Organo design tokens (from the Organo design canvas)
   teal #1AB8A6 · teal-dark #12857A · teal-ink #0F6B61 · teal-soft #D5F3EF
   purple #8B6FE8 · purple-dark #6F52D1 · purple-soft #E8E2FB
   pink #EF476F · pink-dark #D6385E · pink-soft #FDE0E7
   yellow #F2B705 · yellow-soft #FFF1BF
   ink #2E2A4A · muted #6B6785 · faint #8C89A3 · line #ECEAF2 · bg #FAFAFA

   Font: Poppins (Assets/Organo/Fonts, SIL Open Font License). Teks tebal memakai Poppins SemiBold
   lewat tabel bobot FontAsset yang dibuat OrganoApp saat runtime. */

.organo-root {
    -unity-font: url("project://database/Assets/Organo/Fonts/Poppins-Regular.ttf");
    -unity-font-definition: initial;
    flex-grow: 1;
    background-color: rgb(250, 250, 250);
    color: rgb(46, 42, 74);
    font-size: 14px;
}

.organo-root.ar-mode {
    background-color: rgba(0, 0, 0, 0);
}

/* ---------------------------------------------------------------- layout */

.screen-host {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(250, 250, 250);
    overflow: hidden;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s, 0.22s;
    transition-timing-function: ease-out-cubic, ease-out-cubic;
}

.screen.screen--enter {
    opacity: 0;
    translate: 0 12px;
}

.screen.transparent {
    background-color: rgba(0, 0, 0, 0);
}

.row { flex-direction: row; align-items: center; }

.col { flex-direction: column; }

.grow { flex-grow: 1; flex-shrink: 1; }

.center { align-items: center; justify-content: center; }

.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

.scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.scroll .unity-scroll-view__content-container {
    padding-left: 20px;
    padding-right: 20px;
    padding-bottom: 24px;
}

.scroll .unity-scroller--vertical,
.scroll .unity-scroller--horizontal {
    display: none;
}

/* ---------------------------------------------------------------- text */

.organo-root .unity-label {
    color: rgb(46, 42, 74);
    white-space: normal;
    padding: 0;
    margin: 0;
}

.t-display { font-size: 26px; -unity-font-style: bold; }

.t-h3 { font-size: 18px; -unity-font-style: bold; }

.t-overline { font-size: 10px; -unity-font-style: bold; letter-spacing: 0.4px; }

.t-h1 { font-size: 22px; -unity-font-style: bold; }

.t-h2 { font-size: 20px; -unity-font-style: bold; }

.t-title { font-size: 16px; -unity-font-style: bold; }

.t-section { font-size: 15px; -unity-font-style: bold; }

.t-body { font-size: 14px; }

.t-small { font-size: 13px; }

.organo-root .t-caption { font-size: 12px; color: rgb(107, 103, 133); }

.organo-root .t-tiny { font-size: 11px; color: rgb(107, 103, 133); }

.organo-root .t-muted { color: rgb(107, 103, 133); }

.organo-root .t-faint { color: rgb(140, 137, 163); }

.organo-root .t-white { color: rgb(255, 255, 255); }

.organo-root .t-teal { color: rgb(18, 133, 122); }

.organo-root .t-pink { color: rgb(239, 71, 111); }

.organo-root .t-purple { color: rgb(111, 82, 209); }

.b { -unity-font-style: bold; }

.t-center { -unity-text-align: middle-center; }

/* ---------------------------------------------------------------- pressables */

.pressable {
    transition-property: scale, opacity;
    transition-duration: 0.12s, 0.15s;
}

.pressable:hover {
    opacity: 0.92;
}

.pressable:active,
.pressable.pressed {
    scale: 0.97 0.97;
}

.pressable.disabled {
    opacity: 0.45;
}

.btn {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 999px;
    flex-shrink: 0;
}

.btn > .unity-label {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.btn-primary { background-color: rgb(239, 71, 111); }

.organo-root .btn-primary > .unity-label { color: rgb(255, 255, 255); }

.btn-dark { background-color: rgb(46, 42, 74); }

.organo-root .btn-dark > .unity-label { color: rgb(255, 255, 255); }

.btn-teal { background-color: rgb(18, 133, 122); }

.organo-root .btn-teal > .unity-label { color: rgb(255, 255, 255); }

.btn-outline {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(46, 42, 74);
}

.btn-outline > .unity-label { font-size: 14px; -unity-font-style: normal; }

.btn-soft { background-color: rgb(213, 243, 239); min-height: 48px; }

.organo-root .btn-soft > .unity-label { color: rgb(15, 107, 97); font-size: 14px; }

.btn-ghost { background-color: rgba(0, 0, 0, 0); min-height: 44px; }

.organo-root .btn-ghost > .unity-label { color: rgb(107, 103, 133); font-size: 13px; -unity-font-style: normal; }

.btn-small { min-height: 34px; padding-left: 14px; padding-right: 14px; }

.btn-small > .unity-label { font-size: 12px; }

.btn-disabled { background-color: rgb(228, 226, 236); }

.organo-root .btn-disabled > .unity-label { color: rgb(140, 137, 163); }

.icon-btn {
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.icon-btn--glass {
    background-color: rgba(20, 18, 32, 0.55);
    border-radius: 14px;
}

.organo-root .link {
    color: rgb(18, 133, 122);
    -unity-font-style: bold;
    font-size: 12px;
}

/* ---------------------------------------------------------------- surfaces */

.card {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(236, 234, 242);
    border-radius: 14px;
    padding: 12px 14px;
}

.card-lg { border-radius: 16px; }

.pill {
    border-radius: 999px;
    padding: 4px 12px;
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
}

.pill > .unity-label { font-size: 11px; -unity-font-style: bold; }

.chip {
    min-height: 34px;
    padding: 6px 16px;
    border-radius: 999px;
    border-width: 1px;
    border-color: rgb(46, 42, 74);
    background-color: rgb(255, 255, 255);
    margin-right: 8px;
    justify-content: center;
    flex-shrink: 0;
}

.chip > .unity-label { font-size: 13px; }

.chip--on {
    background-color: rgb(26, 184, 166);
    border-color: rgb(26, 184, 166);
}

.organo-root .chip--on > .unity-label { color: rgb(255, 255, 255); -unity-font-style: bold; }

.progress {
    height: 6px;
    border-radius: 999px;
    background-color: rgb(230, 246, 244);
    overflow: hidden;
}

.progress__fill {
    height: 100%;
    border-radius: 999px;
    background-color: rgb(26, 184, 166);
}

.divider {
    height: 1px;
    background-color: rgb(228, 226, 236);
    flex-grow: 1;
}

/* ---------------------------------------------------------------- inputs */

.organo-root .field-label { font-size: 13px; margin-bottom: 6px; }

.field {
    flex-direction: row;
    align-items: center;
    min-height: 50px;
    padding-left: 14px;
    padding-right: 4px;
    border-radius: 14px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(228, 226, 236);
}

.field--focus {
    border-color: rgb(26, 184, 166);
}

.field TextField,
.field .unity-text-field {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.organo-root .field .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 14px;
    color: rgb(46, 42, 74);
    padding: 12px 8px;
    -unity-font: url("project://database/Assets/Organo/Fonts/Poppins-Regular.ttf");
    -unity-font-definition: initial;
}

.organo-root .field .unity-text-element--placeholder,
.organo-root .field .unity-base-text-field__input--placeholder {
    color: rgb(140, 137, 163);
}

.checkbox {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    border-width: 2px;
    border-color: rgb(201, 198, 216);
    background-color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.checkbox--on {
    background-color: rgb(26, 184, 166);
    border-width: 0;
}

/* ---------------------------------------------------------------- top bar */

.topbar {
    flex-direction: row;
    align-items: center;
    height: 60px;
    padding: 16px 20px 0 20px;
    flex-shrink: 0;
}

.topbar__side {
    width: 64px;
    flex-direction: row;
    align-items: center;
}

.topbar__side--end { justify-content: flex-end; }

.topbar__title {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 16px;
    -unity-font-style: bold;
}

/* ---------------------------------------------------------------- bottom nav */

.nav {
    height: 84px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-start;
    padding: 18px 8px 0 8px;
    position: relative;
}

.nav__bg {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.nav__item {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    padding-top: 6px;
}

.nav__icon {
    padding: 5px 12px;
    border-radius: 999px;
}

.nav__icon > .svg {
    --icon-color: rgb(140, 137, 163);
}

.organo-root .nav__label {
    font-size: 11px;
    color: rgb(140, 137, 163);
    margin-top: 2px;
}

.nav__item--on .nav__icon {
    background-color: rgb(213, 243, 239);
}

.nav__item--on .nav__icon > .svg {
    --icon-color: rgb(26, 184, 166);
}

.organo-root .nav__item--on .nav__label {
    color: rgb(18, 133, 122);
    -unity-font-style: bold;
}

.nav__fab {
    position: absolute;
    left: 50%;
    top: -18px;
    margin-left: -30px;
    width: 60px;
    align-items: center;
}

.nav__fab-btn {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    align-items: center;
    justify-content: center;
}

/* ---------------------------------------------------------------- sheets & dialogs */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: flex-end;
}

.scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(20, 18, 32, 0.5);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.sheet {
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    padding: 10px 20px 24px 20px;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-back;
}

.sheet--hidden { translate: 0 110%; }

.scrim--hidden { opacity: 0; }

.sheet__grip {
    align-self: center;
    width: 40px;
    height: 4px;
    border-radius: 999px;
    background-color: rgb(217, 215, 227);
    margin-bottom: 10px;
}

.dialog-wrap {
    justify-content: center;
    padding: 24px;
}

.dialog {
    background-color: rgb(255, 255, 255);
    border-radius: 24px;
    padding: 24px 20px 16px 20px;
    align-items: stretch;
}

.toast {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 100px;
    padding: 10px 14px;
    border-radius: 14px;
    background-color: rgb(46, 42, 74);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.toast--show { opacity: 1; }

.organo-root .toast > .unity-label { color: rgb(255, 255, 255); font-size: 13px; }

/* ---------------------------------------------------------------- 3D viewport */

.viewport3d {
    overflow: hidden;
}

.viewport3d__hint {
    position: absolute;
    bottom: 10px;
    align-self: center;
    padding: 5px 12px;
    border-radius: 999px;
    background-color: rgba(46, 42, 74, 0.7);
}

.organo-root .viewport3d__hint > .unity-label { font-size: 11px; color: rgb(255, 255, 255); }

.hotspot {
    position: absolute;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    margin-top: -7px;
    border-radius: 7px;
    background-color: rgb(26, 184, 166);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.hotspot__ring {
    position: absolute;
    left: -6px;
    top: -6px;
    right: -6px;
    bottom: -6px;
    border-radius: 999px;
    border-width: 1px;
    border-color: rgb(26, 184, 166);
    opacity: 0.8;
}

.hotspot__label {
    position: absolute;
    left: 50%;
    bottom: 16px;
    translate: -50% 0;
    padding: 3px 8px;
    border-radius: 999px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(207, 204, 221);
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(46, 42, 74);
    white-space: nowrap;
}

.hotspot--region .hotspot__label {
    left: 22px;
    bottom: auto;
    top: -6px;
    translate: 0 0;
}

.hotspot--region {
    width: 18px;
    height: 18px;
    margin-left: -9px;
    margin-top: -9px;
    border-radius: 9px;
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(15, 140, 126);
}

.hotspot--selected {
    background-color: rgb(239, 71, 111);
}

.hotspot--selected .hotspot__label {
    background-color: rgb(46, 42, 74);
    border-color: rgb(46, 42, 74);
    color: rgb(255, 255, 255);
}

.callout {
    position: absolute;
    width: 128px;
    padding: 8px 10px;
    border-radius: 12px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(236, 234, 242);
}

.slot-badge {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 48px;
    padding: 6px 10px;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.85);
    border-width: 1px;
    border-color: rgb(236, 234, 242);
    border-left-width: 1px;
}

.organo-root .slot-badge > .unity-label { font-size: 10px; color: rgb(107, 103, 133); -unity-text-align: middle-center; }

/* ---------------------------------------------------------------- organ cards */

.organ-card {
    border-radius: 20px;
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    overflow: hidden;
    align-items: center;
    padding-bottom: 14px;
}

.organ-card__band {
    align-self: stretch;
    padding: 7px 8px;
}

.organo-root .organ-card__band > .unity-label {
    font-size: 10px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
}

.focus-ring {
    border-width: 2px;
    border-color: rgb(139, 111, 232);
}

/* ---------------------------------------------------------------- accessibility text sizes */

.text-small .t-body, .text-small .t-small { font-size: 12px; }

.text-large .t-body { font-size: 17px; }

.text-large .t-small, .text-large .t-caption { font-size: 15px; }

.text-large .t-title { font-size: 18px; }

/* ---------------------------------------------------------------- style guide: komponen */

.card { border-radius: 16px; }

.btn-outline { min-height: 48px; }

.organo-root .btn-outline > .unity-label { font-size: 14px; -unity-font-style: normal; }

.organo-root .btn-soft > .unity-label { -unity-font-style: bold; }

.btn-small { min-height: 34px; }

.organo-root .btn-small > .unity-label { font-size: 12px; -unity-font-style: bold; }

.btn-pink-small { background-color: rgb(239, 71, 111); min-height: 34px; padding-left: 14px; padding-right: 14px; }

.organo-root .btn-pink-small > .unity-label { color: rgb(255, 255, 255); font-size: 12px; -unity-font-style: bold; }

/* input: cincin fokus 3px #D5F3EF di luar border teal */
.field-ring {
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 17px;
    margin: -3px;
}

.field-ring--focus { border-color: rgb(213, 243, 239); }

/* switch 44x26 */
.switch {
    width: 44px;
    height: 26px;
    background-color: rgb(201, 198, 216);
    transition-property: background-color;
    transition-duration: 0.2s;
    flex-shrink: 0;
}

.switch--on { background-color: rgb(26, 184, 166); }

.switch__knob {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: rgb(255, 255, 255);
    transition-property: left;
    transition-duration: 0.2s;
}

.switch--on > .switch__knob { left: 21px; }

/* navbar: hover & tekan */
.nav__item:hover .nav__icon { background-color: rgb(227, 247, 244); translate: 0 -1px; }

.nav__item:hover .nav__icon > .svg { --icon-color: rgb(18, 133, 122); }

.nav__item--on:hover .nav__icon { background-color: rgb(189, 235, 229); }

.organo-root .nav__item--on:hover .nav__label { color: rgb(15, 107, 97); }

.nav__item.pressable:active,
.nav__fab.pressable:active,
.nav__item.pressable.pressed,
.nav__fab.pressable.pressed { scale: 0.95 0.95; }

.nav__fab-btn { transition-property: scale; transition-duration: 0.15s; }

.nav__fab:hover .nav__fab-btn { scale: 1.04 1.04; }

/* kartu organ: hover naik 2px */
.organ-card { transition-property: translate; transition-duration: 0.15s; }

.organ-card:hover { translate: 0 -2px; }

/* Mode Aksesibilitas: kurangi animasi */
.reduce-motion * { transition-duration: 0s; }

/* ---------- kuis drag & drop ---------- */
.drop-hover {
    border-color: rgb(111, 82, 209);
    background-color: rgb(243, 239, 253);
    scale: 1.12 1.12;
}

.drag-ghost {
    border-color: rgb(111, 82, 209);
}

.drop-slot {
    min-height: 64px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgb(189, 186, 206);
    background-color: rgb(255, 255, 255);
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
}

/* Mode Aksesibilitas: kontras tinggi — teks abu-abu (keterangan) jadi gelap supaya mudah dibaca */
.organo-root.high-contrast .t-caption,
.organo-root.high-contrast .t-tiny,
.organo-root.high-contrast .t-muted { color: rgb(46, 42, 74); }
